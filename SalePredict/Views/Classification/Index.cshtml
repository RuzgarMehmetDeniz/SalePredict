@model SalePredict.Models.ProductSalesPredictionViewModel

@{
    Layout = null;
    ViewData["Title"] = "Ürün Satış Tahmini";
}

<div class="container mt-5">

    <h2>Köln Ürün Satış Tahmini</h2>

    <p class="text-muted">
        Seçilen ürünün ilgili ayda 7.000 adedin üzerinde
        satış yapıp yapmayacağını tahmin eder.
    </p>

    <div class="card mt-4">
        <div class="card-body">

            <form method="post">

                <div class="mb-3">
                    <label class="form-label">
                        Ürün
                    </label>

                    <select asp-for="ProductName"
                            class="form-control">

                        <option value="">Ürün Seçiniz</option>
                        <option value="Espresso">Espresso</option>
                        <option value="Americano">Americano</option>
                        <option value="Latte">Latte</option>
                        <option value="Cappuccino">Cappuccino</option>
                        <option value="Mocha">Mocha</option>
                        <option value="Cold Brew">Cold Brew</option>
                        <option value="Filtre Kahve">Filtre Kahve</option>
                        <option value="Çay">Çay</option>
                        <option value="Kruvasan">Kruvasan</option>
                        <option value="Cheesecake">Cheesecake</option>

                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Ürün Fiyatı
                    </label>

                    <input asp-for="ProductPrice"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Ay
                    </label>

                    <select asp-for="Month"
                            class="form-control">

                        <option value="1">Ocak</option>
                        <option value="2">Şubat</option>
                        <option value="3">Mart</option>
                        <option value="4">Nisan</option>
                        <option value="5">Mayıs</option>
                        <option value="6">Haziran</option>
                        <option value="7">Temmuz</option>
                        <option value="8">Ağustos</option>
                        <option value="9">Eylül</option>
                        <option value="10">Ekim</option>
                        <option value="11">Kasım</option>
                        <option value="12">Aralık</option>

                    </select>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Tahmin Et
                </button>

            </form>

        </div>
    </div>

    @if (Model.Prediction.HasValue)
    {
        <div class="card mt-4">
            <div class="card-body">

                <h4>Tahmin Sonucu</h4>

                @if (Model.Prediction.Value)
                {
                    <div class="alert alert-success mt-3">
                        <strong>EVET</strong>

                        <br />

                        Bu ürünün Köln'de
                        7.000 adedin üzerinde satılması bekleniyor.
                    </div>
                }
                else
                {
                    <div class="alert alert-danger mt-3">
                        <strong>HAYIR</strong>

                        <br />

                        Bu ürünün Köln'de
                        7.000 adedin üzerinde satılması beklenmiyor.
                    </div>
                }

                <p>
                    Model Olasılığı:
                    <strong>
                        %@((Model.Probability.Value * 100).ToString("0.00"))
                    </strong>
                </p>

            </div>
        </div>
    }

</div>

