@model SalePredict.Web.Models.Shared.KpiCardViewModel

<div class="card kpi-card" id="@Model.Id">
    <div class="kpi-header">
        <span class="kpi-label">@Model.Label</span>
        <div class="kpi-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 17l6-6 4 4 8-8" />
            </svg>
        </div>
    </div>
    <div class="kpi-value">@Model.Value</div>
    <div class="kpi-delta @(Model.DeltaPercent >= 0 ? "up" : "down")">
        <span>@(Model.DeltaPercent >= 0 ? "▲" : "▼") @Math.Abs(Model.DeltaPercent).ToString("0.0")%</span>
    </div>
    @if (Model.Sparkline != null && Model.Sparkline.Any())
    {
        <div class="kpi-sparkline">
            <canvas id="@(Model.Id)-sparkline"></canvas>
        </div>
        <script type="application/json" id="@(Model.Id)-sparkline-data">@Html.Raw(Json.Serialize(Model.Sparkline))</script>
        <script>
            document.addEventListener("sp:ready", function () {
                SP.renderSparkline("@(Model.Id)-sparkline", "@(Model.Id)-sparkline-data");
            });
        </script>
    }
</div>
