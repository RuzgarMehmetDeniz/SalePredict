@{
    var active = ViewData["Active"] as string ?? "Dashboard";
    bool IsActive(string key) => string.Equals(active, key, StringComparison.OrdinalIgnoreCase);
    string ActiveClass(string key) => IsActive(key) ? "sidebar-link active" : "sidebar-link";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — SalePredict Admin</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <div class="mark">SP</div>
                <div>
                    <span class="name">SalePredict</span>
                    <span class="sub">Sales Intelligence</span>
                </div>
            </div>

            <div class="sidebar-section-label">Analytics</div>
            <ul class="sidebar-nav">
                <li>
                    <a class="@ActiveClass("Dashboard")" asp-controller="Admin" asp-action="Dashboard">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" /></svg>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a class="@ActiveClass("SalesAnalysis")" asp-controller="Admin" asp-action="SalesAnalysis">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 3v18h18" /><path d="M7 15l4-5 3 3 5-7" /></svg>
                        <span>Sales Analysis</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-section-label">ML Modülleri</div>
            <ul class="sidebar-nav">
                <li>
                    <a class="@ActiveClass("Forecasting")" asp-controller="Admin" asp-action="Forecasting">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 17l5-6 4 3 6-8 3 4" /><path d="M3 21h18" /></svg>
                        <span>Forecasting</span>
                    </a>
                </li>
                <li>
                    <a class="@ActiveClass("BinaryClassification")" asp-controller="Admin" asp-action="BinaryClassification">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="8" cy="12" r="4" /><path d="M14 8h6M14 12h6M14 16h6" /></svg>
                        <span>Binary Classification</span>
                    </a>
                </li>
                <li>
                    <a class="@ActiveClass("MulticlassClassification")" asp-controller="Admin" asp-action="MulticlassClassification">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="8.5" y="14" width="7" height="7" rx="1.5" /></svg>
                        <span>Multiclass Classification</span>
                    </a>
                </li>
                <li>
                    <a class="@ActiveClass("AnomalyDetection")" asp-controller="Admin" asp-action="AnomalyDetection">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3l9 16H3z" /><path d="M12 9v5" /><circle cx="12" cy="17" r="0.6" fill="currentColor" /></svg>
                        <span>Anomaly Detection</span>
                    </a>
                </li>
                <li>
                    <a class="@ActiveClass("Clustering")" asp-controller="Admin" asp-action="Clustering">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="6" cy="6" r="2.5" /><circle cx="6" cy="14" r="2.5" /><circle cx="16" cy="9" r="3.5" /><circle cx="17" cy="18" r="2.5" /></svg>
                        <span>Clustering</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-section-label">Veri</div>
            <ul class="sidebar-nav">
                <li>
                    <a class="@ActiveClass("Products")" asp-controller="Admin" asp-action="Products">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 8l-9-5-9 5 9 5 9-5z" /><path d="M3 8v8l9 5 9-5V8" /></svg>
                        <span>Products</span>
                    </a>
                </li>
                <li>
                    <a class="@ActiveClass("Categories")" asp-controller="Admin" asp-action="Categories">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="8" height="8" rx="1.5" /><rect x="13" y="3" width="8" height="8" rx="1.5" /><rect x="3" y="13" width="8" height="8" rx="1.5" /><rect x="13" y="13" width="8" height="8" rx="1.5" /></svg>
                        <span>Categories</span>
                    </a>
                </li>
                <li>
                    <a class="@ActiveClass("Cities")" asp-controller="Admin" asp-action="Cities">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s7-6.5 7-12a7 7 0 10-14 0c0 5.5 7 12 7 12z" /><circle cx="12" cy="9" r="2.3" /></svg>
                        <span>Cities</span>
                    </a>
                </li>
                <li>
                    <a class="@ActiveClass("Orders")" asp-controller="Admin" asp-action="Orders">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="6" width="16" height="15" rx="2" /><path d="M9 6V4a3 3 0 016 0v2" /></svg>
                        <span>Orders</span>
                    </a>
                </li>
                <li>
                    <a class="@ActiveClass("Reports")" asp-controller="Admin" asp-action="Reports">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 2h9l5 5v15H6z" /><path d="M14 2v6h6" /><path d="M9 13h6M9 17h6" /></svg>
                        <span>Reports</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <ul class="sidebar-nav" style="padding:0 0 6px;">
                    <li>
                        <a class="sidebar-link" asp-controller="Admin" asp-action="Settings">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 00.34 1.87l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.7 1.7 0 00-1.87-.34 1.7 1.7 0 00-1 1.55V21a2 2 0 11-4 0v-.09a1.7 1.7 0 00-1-1.55 1.7 1.7 0 00-1.87.34l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.7 1.7 0 00.34-1.87 1.7 1.7 0 00-1.55-1H3a2 2 0 110-4h.09a1.7 1.7 0 001.55-1 1.7 1.7 0 00-.34-1.87l-.06-.06a2 2 0 112.83-2.83l.06.06a1.7 1.7 0 001.87.34H9a1.7 1.7 0 001-1.55V3a2 2 0 114 0v.09a1.7 1.7 0 001 1.55 1.7 1.7 0 001.87-.34l.06-.06a2 2 0 112.83 2.83l-.06.06a1.7 1.7 0 00-.34 1.87V9a1.7 1.7 0 001.55 1H21a2 2 0 110 4h-.09a1.7 1.7 0 00-1.55 1z" /></svg>
                            <span>Settings</span>
                        </a>
                    </li>
                    <li>
                        <a class="sidebar-link" asp-controller="Account" asp-action="Logout">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" /><path d="M16 17l5-5-5-5" /><path d="M21 12H9" /></svg>
                            <span>Logout</span>
                        </a>
                    </li>
                </ul>
                <div class="sidebar-user">
                    <div class="avatar">@(ViewData["AdminInitials"] ?? "AD")</div>
                    <div class="who">
                        <div class="n">@(ViewData["AdminName"] ?? "Admin User")</div>
                        <div class="r">@(ViewData["AdminRole"] ?? "Sales Ops")</div>
                    </div>
                </div>
            </div>
        </aside>

        <div class="main-col">
            <header class="topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle" data-sidebar-toggle type="button" aria-label="Sidebar'ı daralt/genişlet">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                    </button>
                    <div>
                        <div class="page-title">@ViewData["Title"]</div>
                        @if (ViewData["Subtitle"] != null)
                        {
                            <div class="page-subtitle">@ViewData["Subtitle"]</div>
                        }
                    </div>
                </div>
                <div class="topbar-right">
                    <div class="topbar-search">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
                        <span>Ürün, şehir veya sipariş ara…</span>
                    </div>
                    <button class="icon-btn" type="button" aria-label="Bildirimler">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.7 21a2 2 0 01-3.4 0" /></svg>
                        <span class="dot"></span>
                    </button>
                </div>
            </header>

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>