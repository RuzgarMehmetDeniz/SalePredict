@model SalePredict.Web.Models.Shared.FilterPanelViewModel
@*
    Kullanım: her sayfa kendi filtre listesini FilterPanelViewModel.Fields içinde
    Controller'dan hazırlayıp gönderir (dropdown seçenekleri dahil, DB'den).
    Form submit edildiğinde asp-action GET ile aynı sayfaya query string döner,
    Controller bunları okuyup ViewModel'i yeniden doldurur.
*@
<form class="card filter-panel" method="get" asp-controller="@Model.Controller" asp-action="@Model.Action">
    @foreach (var field in Model.Fields)
    {
        <div class="field">
            <label for="@field.Name">@field.Label</label>
            @if (field.Type == SalePredict.Web.Models.Shared.FilterFieldType.Select)
            {
                <select id="@field.Name" name="@field.Name">
                    <option value="">Tümü</option>
                    @foreach (var opt in field.Options)
                    {
                        <option value="@opt.Value" selected="@(opt.Value == field.SelectedValue)">@opt.Text</option>
                    }
                </select>
            }
            else if (field.Type == SalePredict.Web.Models.Shared.FilterFieldType.DateRange)
            {
                <input type="date" id="@(field.Name)_start" name="@(field.Name)_start" value="@field.DateStart?.ToString("yyyy-MM-dd")" />
            }
            else
            {
                <input type="text" id="@field.Name" name="@field.Name" value="@field.SelectedValue" placeholder="@field.Placeholder" />
            }
        </div>
    }
    <div class="actions">
        <button type="submit" class="btn btn-primary">Filtrele</button>
        <a class="btn btn-secondary" asp-controller="@Model.Controller" asp-action="@Model.Action">Sıfırla</a>
    </div>
</form>
