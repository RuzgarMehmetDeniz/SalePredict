@model SalePredict.Web.Models.Shared.PaginationViewModel
@{
    var start = Model.TotalItems == 0 ? 0 : (Model.CurrentPage - 1) * Model.PageSize + 1;
    var end = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems);
}
<div class="table-pagination">
    <span>@start–@end / @Model.TotalItems kayıt</span>
    <div class="pagination-controls">
        <a class="page-btn" asp-controller="@Model.Controller" asp-action="@Model.Action"
           asp-route-page="@(Model.CurrentPage - 1)" aria-disabled="@(Model.CurrentPage <= 1)">‹</a>

        @for (var p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)
        {
            <a class="page-btn @(p == Model.CurrentPage ? "active" : "")"
               asp-controller="@Model.Controller" asp-action="@Model.Action" asp-route-page="@p">@p</a>
        }

        <a class="page-btn" asp-controller="@Model.Controller" asp-action="@Model.Action"
           asp-route-page="@(Model.CurrentPage + 1)" aria-disabled="@(Model.CurrentPage >= Model.TotalPages)">›</a>
    </div>
</div>
