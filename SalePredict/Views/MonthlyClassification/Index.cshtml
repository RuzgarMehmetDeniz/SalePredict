@model List<SalePredict.Models.ProductPredictionResultViewModel>

@{
    Layout = null;
    ViewData["Title"] = "Milano Ürün Satış Sınıflandırması";
}

<div class="container mt-5">

    <div class="mb-4">
        <h2>Milano Ürün Satış Tahmini</h2>

        <p class="text-muted">
            Ürünlerin son 3 aylık satış performanslarına göre
            önümüzdeki ay 7.000 adet satış sınırını geçip
            geçmeyeceği tahmin edilmektedir.
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-header">
            <strong>Ürün Bazlı Tahmin Sonuçları</strong>
        </div>

        <div class="card-body">

            <table class="table table-bordered table-striped align-middle">

                <thead>
                    <tr>
                        <th>Ürün</th>
                        <th>3 Ay Önce</th>
                        <th>2 Ay Önce</th>
                        <th>Son Ay</th>
                        <th>3 Aylık Ortalama</th>
                        <th>7.000'i Aşar mı?</th>
                        <th>Olasılık</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @item.ProductName
                                </strong>
                            </td>

                            <td>
                                @item.ThreeMonthsAgoSales.ToString("N0")
                            </td>

                            <td>
                                @item.TwoMonthsAgoSales.ToString("N0")
                            </td>

                            <td>
                                @item.LastMonthSales.ToString("N0")
                            </td>

                            <td>
                                @item.Last3MonthAverage.ToString("N0")
                            </td>

                            <td>
                                @if (item.Prediction)
                                {
                                    <span class="badge bg-success">
                                        EVET
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        HAYIR
                                    </span>
                                }
                            </td>

                            <td>
                                <strong>
                                    %@((item.Probability * 100).ToString("0.00"))
                                </strong>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

